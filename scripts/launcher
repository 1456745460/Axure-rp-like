#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="/Users/wangbingbing/htmlProject/prototype_design"
APP_URL="http://localhost:5173"
NODE_BIN="$(command -v node 2>/dev/null || true)"

if [[ -z "$NODE_BIN" ]]; then
  for candidate in "$HOME"/.nvm/versions/node/*/bin/node /opt/homebrew/bin/node /usr/local/bin/node; do
    if [[ -x "$candidate" ]]; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi

if [[ -z "$NODE_BIN" || ! -x "$NODE_BIN" ]]; then
  osascript -e 'display alert "未找到 Node.js，请先安装 Node.js 后再启动。" as warning' 2>/dev/null || true
  exit 1
fi

export PATH="$(dirname "$NODE_BIN"):$PATH"
cd "$PROJECT_DIR"

if curl --silent --fail --max-time 1 "$APP_URL" >/dev/null 2>&1; then
  open "$APP_URL"
  exit 0
fi

LOG_FILE="$HOME/Library/Logs/Axure RP Like.log"
nohup npm run dev >"$LOG_FILE" 2>&1 </dev/null &

for attempt in {1..50}; do
  if curl --silent --fail --max-time 1 "$APP_URL" >/dev/null 2>&1; then
    open "$APP_URL"
    exit 0
  fi
  sleep 0.2
done

osascript -e 'display alert "启动失败，请检查 ~/Library/Logs/Axure RP Like.log。" as warning' 2>/dev/null || true
exit 1
